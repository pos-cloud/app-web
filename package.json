{
  "name": "pos-cloud",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-tinymce-assets.cjs",
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:prod": "ng build --configuration production",
    "build:dev": "ng build --configuration dev",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\" \"setup-jest.ts\" \"jest.config.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"setup-jest.ts\" \"jest.config.js\"",
    "lint:imports": "eslint \"src/**/*.ts\" \"setup-jest.ts\" --max-warnings=0",
    "sanity": "npm run format:check && npm run lint:imports",
    "sanity:fix": "eslint \"src/**/*.ts\" \"setup-jest.ts\" --fix && npm run format",
    "tienda-nube": "cd services/tienda-nube && npm run start:dev",
    "api-v1": "cd services/api-v1 && npm run start"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.7",
    "@angular/cdk": "^15.2.7",
    "@angular/common": "^15.2.7",
    "@angular/compiler": "^15.2.7",
    "@angular/core": "^15.2.7",
    "@angular/forms": "^15.2.7",
    "@angular/platform-browser": "^15.2.7",
    "@angular/platform-browser-dynamic": "^15.2.7",
    "@angular/router": "^15.2.7",
    "@angular/service-worker": "^15.2.10",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@mercadopago/sdk-js": "^0.0.3",
    "@ng-bootstrap/ng-bootstrap": "^11.0.0",
    "@ngx-translate/core": "^11.0.1",
    "@ngx-translate/http-loader": "^4.0.0",
    "@tinymce/tinymce-angular": "^6.0.1",
    "apexcharts": "3.40.0",
    "bootstrap": "^4.3.1",
    "file-saver": "^2.0.0",
    "font-awesome": "^4.7.0",
    "jspdf": "^2.5.0",
    "jsqr": "^1.2.0",
    "mercadopago": "^2.3.0",
    "moment": "^2.24.0",
    "ng-apexcharts": "1.7.6",
    "ng-multiselect-dropdown": "^0.2.14",
    "ngx-pagination": "^3.3.0",
    "print-js": "^1.6.0",
    "rxjs": "^7.8.1",
    "simple-keyboard": "^2.27.56",
    "tether": "^1.4.0",
    "tinymce": "^8.4.0",
    "xlsx": "^0.17.5",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.6",
    "@angular/cli": "^15.2.6",
    "@angular/compiler-cli": "^15.2.7",
    "@angular/localize": "^15.2.7",
    "@playwright/test": "^1.49.1",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/parser": "^6.21.0",
    "ajv": "^7.2.4",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^13.1.6",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "4.8.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pos-cloud/app-web.git"
  }
}
